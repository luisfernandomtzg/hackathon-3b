# Nombres sin valores. Los valores viven en .env.local (ignorado) y en Vercel.

# Supabase — la URL es pública; la llave secreta SOLO se usa en servidor.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# API de modelo (opcional) — SOLO servidor.
ANTHROPIC_API_KEY=

# Mapas / ruteo (opcional, se decide con el reto)
MAPAS_API_KEY=
